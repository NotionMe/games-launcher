<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
  minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0"
  style="-fx-background-color: #3D3D3D; -fx-background-radius: 20;"
  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="ua.notion.MainMenuController">
  <top>
    <AnchorPane fx:id="topPane" onMouseDragged="#handleMovementAction"
      onMousePressed="#handlePressAction" prefHeight="40.0" prefWidth="800.0"
      BorderPane.alignment="CENTER">
      <children>
        <HBox alignment="CENTER" spacing="12.0" AnchorPane.rightAnchor="14.0"
          AnchorPane.topAnchor="13.0">
          <children>
            <Button fx:id="buttonFull" onAction="#handleFullAction" prefHeight="15.0"
              prefWidth="9.0"
              style="-fx-background-color: #00FF09; -fx-background-radius: 50%; -fx-min-width: 15; -fx-min-height: 15; -fx-max-width: 15; -fx-max-height: 15; -fx-padding: 0; -fx-background-insets: 0"/>
            <Button fx:id="buttonMin" onAction="#handleMinAction" prefHeight="15.0" prefWidth="9.0"
              style="-fx-background-color: #C88142; -fx-background-radius: 50%; -fx-min-width: 15; -fx-min-height: 15; -fx-max-width: 15; -fx-max-height: 15; -fx-padding: 0; -fx-background-insets: 0;"/>
            <Button fx:id="buttonClose" onAction="#handleCloseAction" prefHeight="15.0"
              prefWidth="9.0"
              style="-fx-background-color: #FF0000; -fx-background-radius: 50%; -fx-min-width: 15; -fx-min-height: 15; -fx-max-width: 15; -fx-max-height: 15; -fx-padding: 0; -fx-background-insets: 0;">
              <cursor>
                <Cursor fx:constant="DEFAULT"/>
              </cursor>
            </Button>
          </children>
        </HBox>
      </children>
    </AnchorPane>
  </top>
</BorderPane>